# Copy to .env (git-ignored). Notebooks and scripts read it; never commit real keys.

# NVIDIA API catalog (build.nvidia.com) - hosted Nemotron 3.5 Lightning
NVIDIA_API_KEY=

# Self-hosted Nemotron on vLLM / Red Hat AI (local GPU or Brev): deploy/brev_serve_nemotron.sh
RISKLENS_VLLM_URL=http://localhost:8000/v1
RISKLENS_VLLM_MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
VLLM_API_KEY=

# Defaults for notebooks: auto | vllm | nvidia | mock
RISKLENS_AGENT_BACKEND=auto
RISKLENS_GYM_POLICY=auto

# Agent scripts (scripts/ask.py) - see config/agents.yaml
RISKLENS_LLM_PROVIDER=mock
