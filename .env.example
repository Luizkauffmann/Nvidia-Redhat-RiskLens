# Copy to .env (git-ignored) or export these variables.

# Backend: mock (offline) | nvidia (NVIDIA API catalog) | vllm (self-hosted on Brev) | openai
RISKLENS_LLM_PROVIDER=mock

# NVIDIA API catalog (build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-key-here

# vLLM on an NVIDIA Brev instance (see deploy/brev_serve_nemotron.sh)
# RISKLENS_LLM_BASE_URL=http://<brev-host>:8000/v1
# RISKLENS_LLM_MODEL=nemotron-3.5-lightning

# Optional overrides
# RISKLENS_LLM_API_KEY=
# RISKLENS_DATA_DIR=data/published
# RISKLENS_OUTPUT_DIR=data/outputs
